<UserControl x:Class="ZZZO.Controls.Generator"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:ZZZO.Controls"
             xmlns:converters="clr-namespace:ZZZO.Converters"
             xmlns:wpf="clr-namespace:CefSharp.Wpf;assembly=CefSharp.Wpf"
             xmlns:viewmodels="clr-namespace:ZZZO.ViewModels"
             xmlns:assists="clr-namespace:ZZZO.Assists"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             d:DataContext="{d:DesignInstance Type=viewmodels:GeneratorViewModel}"
             mc:Ignorable="d"
             d:DesignHeight="450"
             d:DesignWidth="800">
  <UserControl.Resources>
    <converters:InverseBooleanConverter x:Key="InverseBooleanConverter" />
    <converters:NotNullConverter x:Key="NotNullConverter" />
    <converters:EnumConverter x:Key="EnumConverter" />
  </UserControl.Resources>

  <DockPanel>
  <GroupBox Header="DOCX + PDF">
    <DockPanel>
      <WrapPanel DockPanel.Dock="Top">
        <ComboBox IsEnabled="{Binding Pracuje, Converter={StaticResource InverseBooleanConverter}}" materialDesign:TextFieldAssist.PrefixText="Šablona → "
                  Style="{StaticResource KompaktniComboBox}"
                  ItemsSource="{Binding GeneratorDocx.Templates}"
                  SelectedValue="{Binding SelectedTemplate, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

        <ComboBox IsEnabled="{Binding Pracuje, Converter={StaticResource InverseBooleanConverter}}" materialDesign:TextFieldAssist.PrefixText="Dokument → "
                  Style="{StaticResource KompaktniComboBox}"
                  ItemsSource="{Binding GeneratorDocx.KindsOfDocuments}"
                  SelectedValue="{Binding SelectedKindOfDocument, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
          <ComboBox.ItemTemplate>
            <DataTemplate>
              <TextBlock Text="{Binding Converter={StaticResource EnumConverter}}" />
            </DataTemplate>
          </ComboBox.ItemTemplate>
        </ComboBox>

        <Button Content="Přegenerovat dokument"
                Command="{Binding GenerateDocumentCmd}" />
        <Button Style="{StaticResource MaterialDesignRaisedSecondaryLightButton}"
                Margin="{StaticResource FormMargin}"
                Command="{Binding ExportDocxCmd}"
                Content="Exportovat do DOCX" />
        <Button Style="{StaticResource MaterialDesignRaisedSecondaryLightButton}"
                Margin="{StaticResource FormMargin}"
                Content="Exportovat do PDF"
                Command="{Binding ExportPdfCmd}" />
        <Button Style="{StaticResource MaterialDesignRaisedSecondaryLightButton}"
                Margin="{StaticResource FormMargin}"
                Content="Tisknout"
                Command="{Binding PrintCmd}" />
        <ProgressBar Style="{StaticResource MaterialDesignCircularProgressBar}"
                     Name="PbGenerator"
                     Width="34"
                     Height="34"
                     Minimum="0"
                     Maximum="100"
                     IsIndeterminate="{Binding Pracuje}" />
      </WrapPanel>
      <local:NahledPdf x:Name="Nahled" />
    </DockPanel>
  </GroupBox>
  </DockPanel>
</UserControl>
