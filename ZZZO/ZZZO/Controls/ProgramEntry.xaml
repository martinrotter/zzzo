<UserControl x:Class="ZZZO.Controls.ProgramEntry"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:local="clr-namespace:ZZZO.Controls" xmlns:c="clr-namespace:ZZZO.Converters">
 <UserControl.Resources><c:EnumConverter x:Key="Enum"/><c:NotNullConverter x:Key="NotNull"/><c:ValidaceConverter x:Key="Validace"/></UserControl.Resources>
 <Grid IsEnabled="{Binding ProgramEntry, Converter={StaticResource NotNull}}">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
  <StackPanel>
   <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
    <StackPanel><TextBlock Text="Typ bodu" Margin="8,0"/><ComboBox ItemsSource="{Binding TypyBoduProgramu}" SelectedItem="{Binding ProgramEntry.Typ}"><ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Converter={StaticResource Enum}}"/></DataTemplate></ComboBox.ItemTemplate></ComboBox></StackPanel>
    <StackPanel Grid.Column="1"><TextBlock Text="Způsob projednání" Margin="8,0"/><ComboBox ItemsSource="{Binding Rezimy}" SelectedItem="{Binding Rezim}"><ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Converter={StaticResource Enum}}"/></DataTemplate></ComboBox.ItemTemplate></ComboBox></StackPanel>
   </Grid>
   <TextBlock Text="Název bodu" Margin="8,5,8,0"/>
   <TextBox Name="NazevBodu" Text="{Binding ProgramEntry.Nadpis, UpdateSourceTrigger=PropertyChanged}"/>
  </StackPanel>
  <TabControl Grid.Row="1" Margin="0,9,0,0" SelectedIndex="{Binding VybranaZalozka}">
   <TabItem Header="Průběh projednání"><local:TinyMceEditor x:Name="EditorBodu" Polozka="{Binding ProgramEntry}"/></TabItem>
   <TabItem Header="{Binding NadpisUsneseni}" IsEnabled="{Binding MaUsneseni}">
    <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="80" MinHeight="55"/><RowDefinition Height="5"/><RowDefinition Height="*"/></Grid.RowDefinitions>
     <WrapPanel x:Name="PanelAkciUsneseni"><Button Content="+ Usnesení" Command="{Binding AddUsneseniCmd}"/><Button Content="Odstranit" Command="{Binding RemoveUsneseniCmd}"/><Button Content="↑" Command="{Binding UsneseniNahoruCmd}"/><Button Content="↓" Command="{Binding UsneseniDoluCmd}"/></WrapPanel>
     <ListBox Grid.Row="1" Name="SeznamUsneseni" Margin="0,8,0,0" ItemsSource="{Binding ProgramEntry.Usneseni}" SelectedItem="{Binding ChosenUsneseni}">
      <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
       <Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Background" Value="Transparent"/>
       <Setter Property="BorderBrush" Value="Transparent"/><Setter Property="BorderThickness" Value="1"/><Setter Property="FocusVisualStyle" Value="{x:Null}"/>
       <Style.Triggers>
        <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{DynamicResource PozadiNajetiPolozky}"/></Trigger>
        <Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="{DynamicResource PozadiVybranePolozky}"/><Setter Property="BorderBrush" Value="{DynamicResource OkrajVybranePolozky}"/></Trigger>
        <MultiTrigger><MultiTrigger.Conditions><Condition Property="IsSelected" Value="True"/><Condition Property="IsKeyboardFocusWithin" Value="True"/></MultiTrigger.Conditions><Setter Property="BorderThickness" Value="2"/></MultiTrigger>
       </Style.Triggers>
      </Style></ListBox.ItemContainerStyle>
      <ListBox.ItemTemplate><DataTemplate><DockPanel>
       <TextBlock DockPanel.Dock="Right" Foreground="#AA5B00"><TextBlock.Text><MultiBinding Converter="{StaticResource Validace}" ConverterParameter="Ikona"><Binding Path="Id"/><Binding Path="DataContext.Core.Chyby" RelativeSource="{RelativeSource AncestorType=Window}"/></MultiBinding></TextBlock.Text></TextBlock>
       <TextBlock Text="{Binding Vytah}" TextTrimming="CharacterEllipsis" MinHeight="20"/>
      </DockPanel></DataTemplate></ListBox.ItemTemplate>
     </ListBox>
     <GridSplitter Grid.Row="2" Height="5" HorizontalAlignment="Stretch"/>
     <local:Resolution Grid.Row="3" DataContext="{Binding ResolutionViewModel}"/>
    </Grid>
   </TabItem>
  </TabControl>
 </Grid>
</UserControl>
