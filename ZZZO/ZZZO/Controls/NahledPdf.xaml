<UserControl x:Class="ZZZO.Controls.NahledPdf"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:pdf="clr-namespace:PdfiumViewer;assembly=PdfiumViewer">
    <pdf:PDFViewer x:Name="Prohlizec" Background="DimGray" Focusable="True" Zoom="1.333333333333"
                   DataContext="{Binding RelativeSource={RelativeSource Self}}"
                   Flags="CorrectFromDpi,Annotations"
                   ZoomMin="0.4" ZoomMax="6.666666666667">
      <pdf:PDFViewer.ContextMenu>
        <ContextMenu><MenuItem Header="Kopírovat vybraný text" Click="Kopirovat" /></ContextMenu>
      </pdf:PDFViewer.ContextMenu>
    </pdf:PDFViewer>
</UserControl>
