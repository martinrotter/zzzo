<UserControl x:Class="ZZZO.Controls.Resolution"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
 xmlns:local="clr-namespace:ZZZO.Controls" xmlns:c="clr-namespace:ZZZO.Converters">
 <UserControl.Resources>
  <c:NotNullConverter x:Key="NotNull"/>
  <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Margin" Value="4"/><Setter Property="Padding" Value="12,4"/><Setter Property="Height" Value="30"/></Style>
 </UserControl.Resources>
 <Grid IsEnabled="{Binding Usneseni, Converter={StaticResource NotNull}}">
  <Grid.ColumnDefinitions><ColumnDefinition Width="*" MinWidth="260"/><ColumnDefinition Width="4"/><ColumnDefinition x:Name="SloupecHlasovani" Width="355" MinWidth="320"/></Grid.ColumnDefinitions>
  <local:TinyMceEditor x:Name="EditorUsneseni" Polozka="{Binding Usneseni}"/>
  <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Stretch"/>
  <DockPanel Grid.Column="2" Margin="5,0,0,0">
   <StackPanel DockPanel.Dock="Top">
    <DockPanel Margin="4,4">
     <Border x:Name="StavHlasovani" DockPanel.Dock="Right" Padding="6" Background="Transparent" Focusable="True"
      AutomationProperties.Name="{Binding Vyhodnoceni.Vysledek}" ToolTipService.InitialShowDelay="200" ToolTipService.ShowDuration="120000">
      <Border.ToolTip><ToolTip DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
       <StackPanel MaxWidth="340">
        <TextBlock Text="{Binding Vyhodnoceni.Vysledek}" FontWeight="SemiBold" Margin="0,0,0,6"/>
        <TextBlock Text="{Binding Vyhodnoceni.Souhrn}" TextWrapping="Wrap"/>
        <TextBlock Margin="0,6,0,0" Text="{Binding Vyhodnoceni.PotrebnychHlasu, StringFormat='Potřebný počet hlasů pro: {0}'}"/>
       </StackPanel>
      </ToolTip></Border.ToolTip>
      <md:PackIcon x:Name="IkonaHlasovani" Width="26" Height="26">
       <md:PackIcon.Style><Style TargetType="md:PackIcon">
        <Setter Property="Kind" Value="AlertCircle"/><Setter Property="Foreground" Value="#B42318"/>
        <Style.Triggers><DataTrigger Binding="{Binding Vyhodnoceni.JeSchvaleno}" Value="True">
         <Setter Property="Kind" Value="CheckCircleOutline"/><Setter Property="Foreground" Value="#32725D"/>
        </DataTrigger></Style.Triggers>
       </Style></md:PackIcon.Style>
      </md:PackIcon>
     </Border>
     <TextBlock Text="Hlasování" FontWeight="SemiBold" VerticalAlignment="Center"/>
    </DockPanel>
    <TextBlock Text="Nastavit všem přítomným:" Margin="4,0"/>
    <WrapPanel><Button Content="Pro" Command="{Binding AllAgreeCmd}"/><Button Content="Proti" Command="{Binding AllDisagreeCmd}"/><Button Content="Zdrželi se" Command="{Binding VsichniSeZdrzeliCmd}"/></WrapPanel>
   </StackPanel>
   <DataGrid x:Name="TabulkaHlasovani" md:DataGridAssist.CellPadding="4,1" md:DataGridAssist.ColumnHeaderPadding="4,2" ItemsSource="{Binding Usneseni.VolbyZastupitelu}" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" CanUserSortColumns="False" HeadersVisibility="Column" RowHeight="34" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
    <DataGrid.CellStyle><Style TargetType="DataGridCell" BasedOn="{StaticResource {x:Type DataGridCell}}"><Setter Property="VerticalContentAlignment" Value="Center"/></Style></DataGrid.CellStyle>
    <DataGrid.ColumnHeaderStyle><Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}"><Setter Property="VerticalContentAlignment" Value="Center"/></Style></DataGrid.ColumnHeaderStyle>
    <DataGrid.Columns>
     <DataGridTemplateColumn Header="Zastupitel" Width="*" IsReadOnly="True"><DataGridTemplateColumn.CellTemplate><DataTemplate>
      <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
       <TextBlock Text="{Binding JmenoPrijmeniZastupitele}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
       <TextBlock Text="{Binding Poznamka}" FontSize="11" Foreground="#68717A" VerticalAlignment="Center" Margin="6,0,0,0">
        <TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers><DataTrigger Binding="{Binding Zastupitel.JePritomen}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
       </TextBlock>
      </StackPanel>
     </DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
     <DataGridTemplateColumn Header="Pro" Width="42"><DataGridTemplateColumn.CellTemplate><DataTemplate><RadioButton ToolTip="Pro" IsEnabled="{Binding Zastupitel.JePritomen}" IsChecked="{Binding Pro, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Center" VerticalAlignment="Center"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
     <DataGridTemplateColumn Header="Proti" Width="45"><DataGridTemplateColumn.CellTemplate><DataTemplate><RadioButton ToolTip="Proti" IsEnabled="{Binding Zastupitel.JePritomen}" IsChecked="{Binding Proti, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Center" VerticalAlignment="Center"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
     <DataGridTemplateColumn Header="Zdržel" Width="55"><DataGridTemplateColumn.CellTemplate><DataTemplate><RadioButton ToolTip="Zdržel se" IsEnabled="{Binding Zastupitel.JePritomen}" IsChecked="{Binding ZdrzelSe, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Center" VerticalAlignment="Center"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
    </DataGrid.Columns>
   </DataGrid>
  </DockPanel>
 </Grid>
</UserControl>
