<UserControl x:Class="ZZZO.Controls.Program"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
 xmlns:local="clr-namespace:ZZZO.Controls" xmlns:api="clr-namespace:ZZZO.Common.API;assembly=ZZZO.Common" xmlns:c="clr-namespace:ZZZO.Converters">
 <UserControl.Resources>
  <c:ValidaceConverter x:Key="Validace"/>
  <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Margin" Value="4"/><Setter Property="Padding" Value="10,4"/><Setter Property="MinWidth" Value="32"/><Setter Property="Height" Value="30"/></Style>
 </UserControl.Resources>
 <DockPanel>
  <Grid>
   <Grid.ColumnDefinitions><ColumnDefinition Width="320" MinWidth="230"/><ColumnDefinition Width="5"/><ColumnDefinition Width="*" MinWidth="460"/></Grid.ColumnDefinitions>
   <GroupBox Header="Body programu">
    <DockPanel>
     <Grid x:Name="PanelAkci" DockPanel.Dock="Bottom" Margin="0,6,0,0">
      <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
      <Button x:Name="PridatBod" Grid.Column="0" Click="OtevritNabidku" ToolTip="Přidat bod nebo podbod">
       <StackPanel Orientation="Horizontal"><md:PackIcon Kind="Plus" VerticalAlignment="Center" Margin="0,0,4,0"/><TextBlock Text="Přidat"/><md:PackIcon Kind="ChevronDown" VerticalAlignment="Center" Margin="4,0,0,0"/></StackPanel>
       <Button.ContextMenu><ContextMenu>
        <MenuItem Header="Běžný bod" Command="{Binding AddProgramEntryCmd}" CommandParameter="{x:Static api:BodProgramu+TypBoduProgramu.BodZasedani}"/>
        <MenuItem Header="Dodaný bod" Command="{Binding AddProgramEntryCmd}" CommandParameter="{x:Static api:BodProgramu+TypBoduProgramu.DoplnenyBodZasedani}"/>
        <MenuItem Header="Podbod vybraného bodu" Command="{Binding PridatPodbodCmd}"/>
        <Separator/>
        <MenuItem Header="Schválení programu" Command="{Binding AddProgramEntryCmd}" CommandParameter="{x:Static api:BodProgramu+TypBoduProgramu.SchvaleniProgramu}"/>
        <MenuItem Header="Zapisovatel a ověřovatelé" Command="{Binding AddProgramEntryCmd}" CommandParameter="{x:Static api:BodProgramu+TypBoduProgramu.SchvaleniZapisOver}"/>
        <MenuItem Header="Kontrola minulého zápisu" Command="{Binding AddProgramEntryCmd}" CommandParameter="{x:Static api:BodProgramu+TypBoduProgramu.KontrolaMinulehoZapisu}"/>
       </ContextMenu></Button.ContextMenu>
      </Button>
      <Button x:Name="AkceBodu" Grid.Column="1" Click="OtevritNabidku" ToolTip="Přesunout, duplikovat nebo odstranit vybraný bod">
       <StackPanel Orientation="Horizontal"><TextBlock Text="Akce"/><md:PackIcon Kind="ChevronDown" VerticalAlignment="Center" Margin="4,0,0,0"/></StackPanel>
       <Button.ContextMenu><ContextMenu>
        <MenuItem Header="Upravit">
         <MenuItem Header="Posunout výše" Command="{Binding MoveProgramEntryUpCmd}"><MenuItem.Icon><md:PackIcon Kind="ArrowUp"/></MenuItem.Icon></MenuItem>
         <MenuItem Header="Posunout níže" Command="{Binding MoveProgramEntryDownCmd}"><MenuItem.Icon><md:PackIcon Kind="ArrowDown"/></MenuItem.Icon></MenuItem>
         <Separator/>
         <MenuItem Header="Změnit na podbod předchozího bodu" Command="{Binding ZmenitNaPodbodCmd}"><MenuItem.Icon><md:PackIcon Kind="ArrowRight"/></MenuItem.Icon></MenuItem>
         <MenuItem Header="Změnit na hlavní bod" Command="{Binding ZmenitNaHlavniCmd}"><MenuItem.Icon><md:PackIcon Kind="ArrowLeft"/></MenuItem.Icon></MenuItem>
        </MenuItem>
        <MenuItem Header="Duplikovat bod" Command="{Binding DuplikovatBodCmd}" ToolTip="Zkopírovat bod, podbody, usnesení i hlasování"><MenuItem.Icon><md:PackIcon Kind="ContentCopy"/></MenuItem.Icon></MenuItem>
        <Separator/>
        <MenuItem Header="Odstranit bod…" Command="{Binding RemoveProgramEntryCmd}"><MenuItem.Icon><md:PackIcon Kind="DeleteOutline"/></MenuItem.Icon></MenuItem>
       </ContextMenu></Button.ContextMenu>
      </Button>
     </Grid>
     <ListView ScrollViewer.HorizontalScrollBarVisibility="Disabled" Name="LvProgram" ItemsSource="{Binding Radky}" SelectedValuePath="Bod" SelectedValue="{Binding ChosenProgramEntry}">
      <ListView.ItemContainerStyle><Style TargetType="ListViewItem" BasedOn="{StaticResource {x:Type ListViewItem}}">
       <Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Padding" Value="0"/>
       <Setter Property="Background" Value="Transparent"/><Setter Property="BorderBrush" Value="Transparent"/><Setter Property="BorderThickness" Value="1"/><Setter Property="FocusVisualStyle" Value="{x:Null}"/>
       <Style.Triggers>
        <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{DynamicResource PozadiNajetiPolozky}"/></Trigger>
        <Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="{DynamicResource PozadiVybranePolozky}"/><Setter Property="BorderBrush" Value="{DynamicResource OkrajVybranePolozky}"/></Trigger>
        <MultiTrigger><MultiTrigger.Conditions><Condition Property="IsSelected" Value="True"/><Condition Property="IsKeyboardFocusWithin" Value="True"/></MultiTrigger.Conditions><Setter Property="BorderThickness" Value="2"/></MultiTrigger>
       </Style.Triggers>
      </Style></ListView.ItemContainerStyle>
      <ListView.ItemTemplate><DataTemplate>
       <Border BorderThickness="4,0,0,0" BorderBrush="{Binding Barva}" Margin="{Binding Odsazeni}" Padding="8,6" ToolTip="{Binding PopisTypu}">
        <DockPanel>
         <TextBlock DockPanel.Dock="Right" Foreground="#AA5B00" VerticalAlignment="Center" Margin="4,0">
          <TextBlock.Text><MultiBinding Converter="{StaticResource Validace}" ConverterParameter="Ikona"><Binding Path="Bod"/><Binding Path="DataContext.Core.Chyby" RelativeSource="{RelativeSource AncestorType=Window}"/></MultiBinding></TextBlock.Text>
          <TextBlock.ToolTip><MultiBinding Converter="{StaticResource Validace}"><Binding Path="Bod"/><Binding Path="DataContext.Core.Chyby" RelativeSource="{RelativeSource AncestorType=Window}"/></MultiBinding></TextBlock.ToolTip>
         </TextBlock>
         <Border DockPanel.Dock="Right" Background="#E6EBEF" CornerRadius="12" MinWidth="24" Height="24" Margin="6,0,0,0" ToolTip="Počet usnesení tohoto bodu"><TextBlock Text="{Binding Bod.Usneseni.Count}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
         <TextBlock Text="{Binding Cislo}" VerticalAlignment="Center"/>
         <TextBlock Text="{Binding Bod.Nadpis}" TextWrapping="Wrap" MaxHeight="44" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
        </DockPanel>
       </Border>
      </DataTemplate></ListView.ItemTemplate>
     </ListView>
    </DockPanel>
   </GroupBox>
   <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch"/>
   <local:ProgramEntry Grid.Column="2" x:Name="UcProgramEntry" DataContext="{Binding EntryViewModel}" Margin="8,0,0,0"/>
  </Grid>
 </DockPanel>
</UserControl>
