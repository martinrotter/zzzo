<UserControl x:Class="ZZZO.Controls.SouhrnValidace"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes">
 <Border Background="#F4F6F7" BorderBrush="#DCE1E5" BorderThickness="0,1,0,0" Padding="10,3">
  <DockPanel>
   <ToggleButton x:Name="TlacitkoValidace" Style="{x:Null}" Width="Auto" Height="Auto" MinWidth="0" MinHeight="0" HorizontalAlignment="Left" Padding="5,3" BorderThickness="0" Background="Transparent" Cursor="Hand"
    ToolTipService.InitialShowDelay="200" ToolTipService.ShowDuration="120000"
    IsEnabled="{Binding ZasedaniLoaded}" AutomationProperties.Name="{Binding StavKontroly}">
    <ToggleButton.Template><ControlTemplate TargetType="ToggleButton"><Border x:Name="Pozadi" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}" CornerRadius="3"><ContentPresenter/></Border><ControlTemplate.Triggers>
     <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Pozadi" Property="Background" Value="#E5E9EC"/></Trigger>
     <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Pozadi" Property="Background" Value="#E5E9EC"/></Trigger>
    </ControlTemplate.Triggers></ControlTemplate></ToggleButton.Template>
    <ToggleButton.ToolTip>
     <ToolTip Background="White" Foreground="#20252A" BorderBrush="#D0D5DA" BorderThickness="1" Padding="12" Placement="Top" DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}" MaxWidth="720">
      <ToolTip.Template><ControlTemplate TargetType="ToolTip"><Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}" CornerRadius="5"><ContentPresenter/></Border></ControlTemplate></ToolTip.Template>
      <StackPanel>
       <TextBlock Text="{Binding StavKontroly}" FontWeight="SemiBold" Margin="0,0,0,6"/>
       <ScrollViewer MaxHeight="380" VerticalScrollBarVisibility="Auto">
        <ItemsControl ItemsSource="{Binding Chyby}"><ItemsControl.ItemTemplate><DataTemplate>
         <TextBlock Text="{Binding Popis}" TextWrapping="Wrap" Margin="0,3" MaxWidth="680"/>
        </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
       </ScrollViewer>
       <TextBlock Text="Kliknutím otevřete seznam s přechodem na problém." FontSize="12" Foreground="#68717A" Margin="0,6,0,0"/>
      </StackPanel>
     </ToolTip>
    </ToggleButton.ToolTip>
    <StackPanel Orientation="Horizontal">
     <md:PackIcon Width="20" Height="20" VerticalAlignment="Center">
      <md:PackIcon.Style><Style TargetType="md:PackIcon">
       <Setter Property="Kind" Value="AlertCircle"/><Setter Property="Foreground" Value="#B42318"/>
       <Style.Triggers><DataTrigger Binding="{Binding Chyby.Count}" Value="0"><Setter Property="Kind" Value="CheckCircleOutline"/><Setter Property="Foreground" Value="#32725D"/></DataTrigger>
       <DataTrigger Binding="{Binding ZasedaniLoaded}" Value="False"><Setter Property="Kind" Value="InformationOutline"/><Setter Property="Foreground" Value="#68717A"/></DataTrigger></Style.Triggers>
      </Style></md:PackIcon.Style>
     </md:PackIcon>
     <TextBlock Text="{Binding StavKontroly}" VerticalAlignment="Center" Margin="7,0,0,0" FontSize="12"/>
    </StackPanel>
   </ToggleButton>
   <Popup x:Name="SeznamChyb" PlacementTarget="{Binding ElementName=TlacitkoValidace}" Placement="Top" StaysOpen="False"
    IsOpen="{Binding IsChecked, ElementName=TlacitkoValidace, Mode=TwoWay}" AllowsTransparency="True"
    DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
    <Border Background="White" BorderBrush="#D0D5DA" BorderThickness="1" CornerRadius="5" Padding="12" Width="650" MaxHeight="420">
     <DockPanel>
      <TextBlock DockPanel.Dock="Top" Text="{Binding StavKontroly}" FontWeight="SemiBold" Margin="4,0,4,8"/>
      <ScrollViewer VerticalScrollBarVisibility="Auto">
       <ItemsControl ItemsSource="{Binding Chyby}"><ItemsControl.ItemTemplate><DataTemplate>
        <Button Command="{Binding DataContext.PrejitNaChybuCmd, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}"
         Click="PrejitNaProblem" Height="Auto" MinHeight="28" HorizontalContentAlignment="Stretch" Margin="0,2" Padding="6" Background="Transparent" Foreground="#744416" Cursor="Hand" BorderThickness="0">
         <Button.Template><ControlTemplate TargetType="Button"><Border x:Name="Pozadi" Padding="{TemplateBinding Padding}" Background="{TemplateBinding Background}" CornerRadius="3"><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Pozadi" Property="Background" Value="#FFF0DB"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Pozadi" Property="Background" Value="#FFF0DB"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Button.Template>
         <TextBlock Text="{Binding Popis}" TextWrapping="Wrap"/>
        </Button>
       </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
      </ScrollViewer>
     </DockPanel>
    </Border>
   </Popup>
  </DockPanel>
 </Border>
</UserControl>
